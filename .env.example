# ============================================
# API Configuration (Choose ONE option below)
# ============================================

# Option 1: OpenAI-Compatible API (OpenRouter, vLLM, local models, etc.)
# Uncomment these lines to use OpenAI-compatible endpoints:
#OPENAI_BASE_URL=https://openrouter.ai/api/v1
#OPENAI_API_KEY=your_openrouter_api_key_here
#OPENAI_MODEL=anthropic/claude-3.5-sonnet

# Option 2: Anthropic Claude API (Direct)
# Uncomment this line to use Anthropic directly:
#ANTHROPIC_API_KEY=your_anthropic_api_key_here
#ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# ============================================
# LLM Configuration (Optional)
# ============================================

# Temperature (0.0 = deterministic, 1.0 = creative)
LLM_TEMPERATURE=0.7

# Maximum tokens per response
LLM_MAX_TOKENS=8192

# ============================================
# Application Settings
# ============================================

# Output Directory for Generated Code
OUTPUT_DIR=./generated_code

# FastAPI Server Port (for web interface)
PORT=8000
